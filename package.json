{
  "name": "frontier-nightmare-fps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "build": "tsc && vite build && tsc -p tsconfig.server.json",
    "preview": "concurrently -k -n server,client -c yellow,cyan \"npm:server\" \"vite preview --host 0.0.0.0\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.0",
    "tsx": "^4.22.3"
  }
}
